{
  "name": "chat",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @chat/shared && npm run build -w @chat/backend && npm run build -w @chat/frontend",
    "dev:backend": "npm run start:dev -w @chat/backend",
    "dev:frontend": "npm run dev -w @chat/frontend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
